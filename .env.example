# ==============================================================================
# ShopScale Environment Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to .env before starting services locally.
# Never commit .env or any file containing live credentials to Git.
# ==============================================================================

# --- Application Environment ---
APP_ENV=development
DEBUG=true

# --- Backend Service (FastAPI) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Security: Generate a secure 32+ byte key for production (e.g. `openssl rand -hex 32`)
SECRET_KEY=dev_insecure_jwt_secret_key_shopscale_replace_in_prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- MySQL Database Configuration ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=shopscale
MYSQL_USER=shopscale_user
MYSQL_PASSWORD=shopscale_dev_password
MYSQL_ROOT_PASSWORD=shopscale_root_dev_password

# Asynchronous DSN (used by FastAPI runtime via aiomysql)
DATABASE_URL=mysql+aiomysql://shopscale_user:shopscale_dev_password@localhost:3306/shopscale

# Synchronous DSN (used by Alembic migration runner via pymysql)
DATABASE_URL_SYNC=mysql+pymysql://shopscale_user:shopscale_dev_password@localhost:3306/shopscale

# --- Frontend Service (Node.js + Express) ---
PORT=3000
BACKEND_URL=http://localhost:8000
